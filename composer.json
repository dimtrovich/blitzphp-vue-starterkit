{
    "name": "dimtrovich/blitzphp-vue-starterkit",
    "type": "project",
    "description": "Kit de démarrage pour des applications BlitzPHP + Vue.Js",
    "homepage": "https://github.com/dimtrovich/blitzphp-vue-starterkit",
    "license": "MIT",
    "authors": [
        {
            "name": "Dimitri Sitchet Tomkeu",
            "email": "dimitrisitchet@gmail.com"
        }
    ],
        "require": {
        "php": "^8.2",
        "blitz-php/framework": "^0.12",
        "dimtrovich/blitzphp-vite": "^1.1"
    },
    "require-dev": {
        "filp/whoops": "^2.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php klinge key:generate",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php klinge serve\" \"npm run dev\" --names=server,vite --kill-others"
        ],
       "post-update-cmd": [
            "BlitzPHP\\Initializer\\ComposerScripts::postUpdate",
            "@php klinge publish"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php klinge key:generate"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "source": "https://github.com/dimtrovich/blitzphp-vue-starterkit"
    }
}