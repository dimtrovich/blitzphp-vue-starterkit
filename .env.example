#--------------------------------------------------------------------
# BlitzPHP vite
#--------------------------------------------------------------------

VITE_AUTO_INJECTING=true
VITE_EXCLUDED_ROUTES='/s'
VITE_ORIGIN='http://localhost:3479'
VITE_PORT=3479
VITE_BUILD_DIR='build'
VITE_ENTRY_FILE='main.js'
VITE_RESOURCES_DIR='src'
VITE_FRAMEWORK='vue'
VITE_BACKUP_FILE='env-BACKUP-1748878217'
