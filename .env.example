#--------------------------------------------------------------------
# Exemple de fichier de configuration d'environnement
#
# Ce fichier peut être utilisé comme point de départ pour vos propres fichiers .env personnalisés,
# et contient la plupart des paramètres possibles disponibles dans une installation par défaut.
#
# Par défaut, tous les paramètres sont commentés.
# Si vous souhaitez remplacer le paramètre, vous devez le dé-commenter en supprimant le '#' au début de la ligne.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONNEMENT
#--------------------------------------------------------------------

# ENVIRONMENT = production

#--------------------------------------------------------------------
# APPLICATION
#--------------------------------------------------------------------

# app.baseURL = ''
app.name = 'BlitzPHP App Skeleton'

